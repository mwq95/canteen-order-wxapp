.container {
  padding: 0;
  min-height: 100vh;
  background: #f5f7fa;
}

.user-card {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  padding: 60rpx 20rpx 80rpx 0rpx;
  display: flex;
  align-items: center;
}

.avatar-btn {
  position: relative;
  margin: 0 !important;
  padding: 0 !important;
  line-height: normal !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

.avatar-btn::after {
  display: none !important;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.2);
}

.user-detail {
  margin-left: 6rpx;
  flex: 1;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.phone {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.role-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.menu-list {
  background: #fff;
  margin-top: -40rpx;
  margin-left: 20rpx;
  margin-right: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}
