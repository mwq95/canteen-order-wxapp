<view class="container">
  <view class="user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
    </button>

    <view class="user-detail">
      <view class="nickname">{{staffName}}</view>
      <view class="phone">{{maskedPhone}}</view>
      <view class="role-tag">{{roleText}}</view>
    </view>
  </view>

  <view class="menu-list">
    <view wx:if="{{canAccessAdmin}}" class="menu-item" bindtap="goToAdmin">
      <view class="menu-icon">⚙️</view>
      <view class="menu-text">管理后台</view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToReminder">
      <view class="menu-icon">🔔</view>
      <view class="menu-text">提醒设置</view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToStats">
      <view class="menu-icon">📊</view>
      <view class="menu-text">订餐统计</view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToHelp">
      <view class="menu-icon">❓</view>
      <view class="menu-text">使用帮助</view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-icon">💬</view>
      <view class="menu-text">意见建议</view>
      <view class="menu-arrow">›</view>
    </view>

  </view>
</view>
