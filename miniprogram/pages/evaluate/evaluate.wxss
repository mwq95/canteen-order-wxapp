.container {
  padding: 20rpx;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.order-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.order-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.evaluate-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.evaluate-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.dish-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.rating-section {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #666;
}

.rating-value {
  font-size: 24rpx;
  color: #faad14;
}

.stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 40rpx;
  color: #ddd;
  transition: color 0.3s;
}

.star.active {
  color: #faad14;
}

.comment-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.comment-label {
  font-size: 28rpx;
  color: #666;
}

.comment-input {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-wrapper {
  position: fixed;
  bottom: 40rpx;
  left: 20rpx;
  right: 20rpx;
}

.submit-btn {
  background: #1890FF;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.submit-btn::after {
  border: none;
}