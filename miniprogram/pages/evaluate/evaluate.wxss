.container {
  padding: 20rpx;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.order-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.order-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.evaluate-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.evaluate-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.dish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.evaluated-tag {
  font-size: 24rpx;
  color: #52c41a;
  background: #f6ffed;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #b7eb8f;
}

.rating-section {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #666;
}

.rating-value {
  font-size: 24rpx;
  color: #faad14;
}

.stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 40rpx;
  color: #ddd;
  transition: color 0.3s;
  padding: 0 4rpx;
}

.star.active {
  color: #faad14;
}

.comment-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.comment-label {
  font-size: 28rpx;
  color: #666;
}

.comment-input {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.comment-display {
  width: 100%;
  min-height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
  color: #666;
}

.dish-actions {
  display: flex;
  justify-content: flex-end;
}

.dish-submit-btn {
  background: #1890FF;
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  line-height: 1.4;
}

.dish-submit-btn::after {
  border: none;
}
