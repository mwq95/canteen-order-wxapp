.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #f5f7fa;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.form-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #999;
}

.date-picker.active {
  color: #333;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
}

.format-options {
  display: flex;
  gap: 20rpx;
}

.format-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.format-option.active {
  background: #e6f7ff;
  border-color: #1890ff;
}

.format-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.format-option text:last-child {
  font-size: 26rpx;
  color: #666;
}

.format-option.active text:last-child {
  color: #1890ff;
  font-weight: 500;
}

.preview-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.preview-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.preview-count {
  font-size: 24rpx;
  color: #999;
}

.preview-table {
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  background: #f5f5f5;
  padding: 20rpx 0;
}

.th {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.th:last-child {
  flex: 2;
}

.table-body {
  max-height: 400rpx;
  overflow-y: auto;
}

.tr {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.tr:last-child {
  border-bottom: none;
}

.td {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  padding: 0 8rpx;
}

.td:last-child {
  flex: 2;
}

.dish-list {
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.preview-btn, .export-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.preview-btn {
  background: #f5f5f5;
  color: #666;
}

.preview-btn.disabled {
  background: #e8e8e8;
  color: #bbb;
}

.export-btn {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.3);
}

.export-btn.disabled {
  background: #e8e8e8;
  color: #bbb;
  box-shadow: none;
}

.preview-btn::after, .export-btn::after {
  border: none;
}

.tips-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
