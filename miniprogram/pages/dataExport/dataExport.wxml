<view class="container">
  <view class="header">
    <view class="title">订餐数据导出</view>
    <view class="subtitle">选择日期范围导出全量订餐数据</view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <view class="form-label">开始日期</view>
      <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
        <view class="date-picker {{startDate ? 'active' : ''}}">
          <text>{{startDate || '请选择开始日期'}}</text>
          <text class="arrow">></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">结束日期</view>
      <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
        <view class="date-picker {{endDate ? 'active' : ''}}">
          <text>{{endDate || '请选择结束日期'}}</text>
          <text class="arrow">></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">导出格式</view>
      <view class="format-options">
        <view class="format-option {{exportFormat === 'excel' ? 'active' : ''}}" bindtap="setFormat" data-format="excel">
          <text class="format-icon">📊</text>
          <text>Excel</text>
        </view>
        <view class="format-option {{exportFormat === 'csv' ? 'active' : ''}}" bindtap="setFormat" data-format="csv">
          <text class="format-icon">📄</text>
          <text>CSV</text>
        </view>
      </view>
    </view>
  </view>

  <view class="preview-section" wx:if="{{previewData.length > 0}}">
    <view class="preview-header">
      <text class="preview-title">数据预览</text>
      <text class="preview-count">共 {{previewData.length}} 条记录</text>
    </view>
    <view class="preview-table">
      <view class="table-header">
        <text class="th">日期</text>
        <text class="th">餐次</text>
        <text class="th">姓名</text>
        <text class="th">菜品</text>
        <text class="th">订单状态</text>
      </view>
      <view class="table-body">
        <view class="tr" wx:for="{{previewData}}" wx:key="index">
          <text class="td">{{item.date}}</text>
          <text class="td">{{item.mealType}}</text>
          <text class="td">{{item.userName}}</text>
          <text class="td dish-list">{{item.dishes}}</text>
          <text class="td dish-list">{{item.status}}</text>

        </view>
      </view>
    </view>
  </view>

  <view class="action-section">
    <button 
      class="preview-btn {{!canExport ? 'disabled' : ''}}" 
      bindtap="previewData"
      disabled="{{!canExport || loading}}"
    >
      <text wx:if="{{!loading}}">预览数据</text>
      <text wx:else>加载中...</text>
    </button>
    
    <button 
      class="export-btn {{!canExport ? 'disabled' : ''}}" 
      bindtap="exportData"
      disabled="{{!canExport || exporting}}"
    >
      <text wx:if="{{!exporting}}">导出{{exportFormat === 'excel' ? 'Excel' : 'CSV'}}</text>
      <text wx:else>导出中...</text>
    </button>
  </view>

  <view class="tips-section">
    <view class="tips-title">导出说明</view>
    <view class="tips-list">
      <text class="tip-item">• 单次导出最多支持3个月的数据</text>
      <text class="tip-item">• 导出文件将保存到手机本地</text>
      <text class="tip-item">• Excel格式支持复杂表格，CSV格式兼容性更好</text>
    </view>
  </view>
</view>
