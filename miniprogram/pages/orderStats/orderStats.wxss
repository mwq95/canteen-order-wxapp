.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
  padding-top: 20rpx;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
}

.stats-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stats-card.highlight {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border: 2rpx solid #91d5ff;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.stats-date {
  font-size: 24rpx;
  color: #999;
}

.stats-row.single {
  justify-content: center;
}

.stat-item {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
}

.stat-num {
  font-size: 64rpx;
  font-weight: bold;
  color: #333;
}

.stat-num.total-big {
  font-size: 72rpx;
  color: #1890FF;
}

.stat-label {
  font-size: 28rpx;
  color: #999;
}
