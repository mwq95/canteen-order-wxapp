.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: #f5f7fa;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
  padding-top: 20rpx;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
}

.stats-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stats-card.highlight {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border: 2rpx solid #91d5ff;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.stats-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.stats-date {
  font-size: 24rpx;
  color: #999;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.2;
}

.stat-num.total-big {
  font-size: 64rpx;
  color: #1890FF;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: #e8e8e8;
  margin: 0 20rpx;
}
