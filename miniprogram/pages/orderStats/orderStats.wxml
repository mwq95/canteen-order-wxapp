<view class="container">
  <view class="header">
    <text class="title">订餐统计</text>
  </view>

  <view class="stats-card">
    <view class="stats-header">
      <text class="stats-label">📅 近30天</text>
      <text class="stats-date">{{thirtyDayRange}}</text>
    </view>
    <view class="stats-row single">
      <view class="stat-item">
        <text class="stat-num">{{thirtyDayCount}}</text>
        <text class="stat-label">次</text>
      </view>
    </view>
  </view>

  <view class="stats-card highlight">
    <view class="stats-header">
      <text class="stats-label">🏆 总计</text>
    </view>
    <view class="stats-row single">
      <view class="stat-item">
        <text class="stat-num total-big">{{totalCount}}</text>
        <text class="stat-label">次</text>
      </view>
    </view>
  </view>
</view>
