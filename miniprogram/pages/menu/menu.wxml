<view class="container">
  <date-nav date="{{selectedDate}}" formatType="short" bind:change="onDateChange" />

  <view wx:if="{{isPast}}" class="past-tip">
    <text>过去的日期不能修改菜单</text>
  </view>

  <view class="meal-section" wx:for="{{meals}}" wx:key="type" wx:for-index="mealIndex">
    <view class="meal-header">
      <view class="meal-title">{{item.type}}</view>
      <button wx:if="{{!isPast}}" class="add-btn" data-index="{{mealIndex}}" bindtap="showAddDish">+ 添加菜品</button>
    </view>

    <view wx:if="{{item.dishes.length === 0}}" class="empty-dishes">
      <text>暂无菜品</text>
    </view>

    <view wx:else class="dish-list">
      <view class="dish-item" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="name" wx:for-index="dishIndex">
        <view class="dish-info">
          <text class="dish-name">{{dish.name}}</text>
        </view>
        <view wx:if="{{!isPast}}" class="delete-btn" data-meal-index="{{mealIndex}}" data-dish-index="{{dishIndex}}" bindtap="deleteDish">删除</view>
      </view>
    </view>
  </view>

  <view class="save-btn-wrapper">
    <button class="save-btn" bindtap="saveMenu">保存菜单</button>
  </view>

  <view wx:if="{{showAddDishModal}}" class="modal-mask" bindtap="cancelAddDish">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title">添加菜品</view>
        <text class="modal-close" bindtap="cancelAddDish">✕</text>
      </view>
      
      <view class="search-section">
        <view class="search-box">
          <text class="search-icon">🔍</text>
          <input 
            class="search-input" 
            placeholder="搜索或输入新菜品..." 
            value="{{dishSearchKeyword}}"
            bindinput="onDishSearch"
          />
          <text wx:if="{{dishSearchKeyword}}" class="clear-icon" bindtap="clearDishSearch">✕</text>
        </view>
      </view>

      <view class="dish-select-list">
        <view wx:if="{{filteredDishList.length > 0}}" class="dish-options">
          <view 
            class="dish-option" 
            wx:for="{{filteredDishList}}" 
            wx:key="_id"
            data-name="{{item.name}}"
            bindtap="selectDish"
          >
            <text class="dish-option-name">{{item.name}}</text>
            <text class="dish-option-count">使用{{item.usageCount || 0}}次</text>
          </view>
        </view>
        
        <view wx:else class="no-dish-tip">
          <text wx:if="{{dishSearchKeyword}}">未找到"{{dishSearchKeyword}}"</text>
          <text wx:else>暂无菜品记录</text>
        </view>
      </view>

      <view wx:if="{{dishSearchKeyword}}" class="add-new-section">
        <button class="add-new-btn" bindtap="addNewDish">
          + 添加新菜品"{{dishSearchKeyword}}"
        </button>
      </view>
    </view>
  </view>
</view>
