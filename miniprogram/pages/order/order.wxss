/**
 * 订餐页面样式 - 统一页面（合并首页和订餐页）
 * 设计原则：
 * - 简洁清晰的视觉层次
 * - 响应式设计，适配不同屏幕
 * - 统一的配色方案
 */

/* ==================== 容器 ==================== */
.container {
  min-height: 100vh;
  padding: 20rpx 30rpx;
  background-color: #f5f7fa;
  box-sizing: border-box;
}

/* ==================== 日期导航区 ==================== */
.date-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.date-nav-btn {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.date-nav-arrow {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.date-nav-text {
  flex: 1;
  text-align: center;
}

.date-nav-text text {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ==================== 加载状态提示 ==================== */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #999999;
}

/* ==================== 无数据提示 ==================== */
.empty-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999999;
}

/* ==================== 餐次区块 ==================== */
.meal-section {
  margin-bottom: 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 餐次标题行 */
.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.meal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 已订标签 */
.ordered-tag {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 已截止标签 */
.disabled-tag {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* ==================== 菜品列表 ==================== */
.dishes-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 菜品项 */
.dish-item {
  position: relative;
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 28rpx;
  background: #fafafa;
  border: 2rpx solid #e8e8e8;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

/* 菜品项 - 可点击状态（默认） */
.dish-item:not(.disabled):active {
  transform: scale(0.95);
  background: #f0f0f0;
}

/* 菜品项 - 选中状态 */
.dish-item.selected {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-color: #1890ff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

/* 菜品名称 */
.dish-name {
  font-size: 26rpx;
  color: #333333;
  white-space: nowrap;
}

.dish-item.selected .dish-name {
  color: #ffffff;
  font-weight: 500;
}

/* 菜品项 - 禁用状态 */
.dish-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 选中标记 */
.check-mark {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 32rpx;
  height: 32rpx;
  background: #52c41a;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
}

/* ==================== 已选菜品显示区 ==================== */
.selected-dishes {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: #f0f5ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #1890ff;
}

.selected-label {
  font-size: 26rpx;
  color: #1890ff;
  font-weight: 500;
  margin-right: 10rpx;
}

.selected-list {
  font-size: 26rpx;
  color: #333333;
}

/* ==================== 提交按钮 ==================== */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.3);
  transition: all 0.3s ease;
  text-align: center;
}

.submit-btn:not(.btn-disabled):active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.2);
}

.submit-btn.btn-disabled {
  background: linear-gradient(135deg, #d9d9d9 0%, #bfbfbf 100%);
  box-shadow: none;
  opacity: 0.6;
}

/* ==================== 数据库初始化区域 ==================== */
.init-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.init-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 30rpx;
  line-height: 1.6;
}

.init-btn {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #faad14 0%, #fa8c16 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(250, 173, 20, 0.3);
}
