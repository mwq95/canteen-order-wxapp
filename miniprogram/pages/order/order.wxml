<!--
  订餐页面 - 统一页面（合并首页和订餐页）
  页面结构：
  - 顶部：日期导航栏
  - 中部：菜单展示区（早中晚三餐）
  - 底部：数据库初始化按钮（仅在需要时显示）
-->

<view class="container">
  
  <!-- ==================== 日期导航区 ==================== -->
  <view class="date-nav">
    <view class="date-nav-btn" bindtap="prevDay">
      <text class="date-nav-arrow">←</text>
    </view>
    <view class="date-nav-text">
      <text>{{selectedDateStr}}</text>
    </view>
    <view class="date-nav-btn" bindtap="nextDay">
      <text class="date-nav-arrow">→</text>
    </view>
  </view>

  <!-- ==================== 加载状态提示 ==================== -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ==================== 无菜单数据提示 ==================== -->
  <block wx:elif="{{!menuData && !showInitButton}}">
    <view class="empty-container">
      <text class="empty-text">暂无菜单数据</text>
    </view>
  </block>

  <!-- ==================== 菜单展示区 ==================== -->
  <block wx:elif="{{menuData}}">
    
    <!-- 遍历三餐：早餐、午餐、晚餐 -->
    <view 
      wx:for="{{menuData.meals}}" 
      wx:key="type" 
      class="meal-section"
    >
      
      <!-- 餐次标题行 -->
      <view class="meal-header">
        <view class="meal-title-row">
          <view class="meal-title">{{item.type}}</view>
          <view class="meal-deadline">截止时间：{{deadlines[item.type === '早餐' ? 'breakfast' : (item.type === '午餐' ? 'lunch' : 'dinner')]}}</view>
        </view>
        
        <!-- 标签容器 -->
        <view class="meal-tags">
          <view wx:if="{{orders[item.type].status === 'ordered'}}" class="ordered-tag">
            已订
          </view>
          
          <view wx:if="{{disabledMeals[item.type]}}" class="disabled-tag">
            已截止
          </view>
        </view>
      </view>

      <!-- 菜品列表 -->
      <view class="dishes-list">
        
        <!-- 遍历每个菜品 - 使用数据驱动的 selected 属性 -->
        <view 
          wx:for="{{item.dishes}}" 
          wx:key="name" 
          wx:for-item="dish"
          class="dish-item {{dish.selected ? 'selected' : ''}} {{disabledMeals[item.type] ? 'disabled' : ''}}"
          data-meal-type="{{item.type}}"
          data-dish-name="{{dish.name}}"
          data-index="{{index}}"
          bindtap="toggleDish"
        >
          
          <!-- 菜品名称 -->
          <text class="dish-name">{{dish.name}}</text>
          
          <!-- 选中标记 - 数据驱动 -->
          <view wx:if="{{dish.selected}}" class="check-mark">
            ✓
          </view>
        </view>
      </view>

      <!-- 提交按钮 -->
      <button 
        class="submit-btn {{disabledMeals[item.type] ? 'btn-disabled' : ''}}"
        data-meal-type="{{item.type}}"
        bindtap="submitOrder"
        disabled="{{disabledMeals[item.type]}}"
      >
        {{orders[item.type].status === 'ordered' ? '修改' : '订餐'}}
      </button>
    </view>
  </block>

  <!-- ==================== 数据库初始化按钮 ==================== -->
  <view wx:if="{{showInitButton}}" class="init-container">
    <text class="init-text">数据库未初始化，请点击下方按钮初始化</text>
    <button class="init-btn" bindtap="initDatabase">
      初始化数据库
    </button>
  </view>

</view>