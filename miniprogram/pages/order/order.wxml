<view class="container">
  <view class="date-nav">
    <view class="nav-btn" bindtap="prevDay">
      <text>←</text>
    </view>
    <view class="date-display">{{selectedDateStr}}</view>
    <view class="nav-btn" bindtap="nextDay">
      <text>→</text>
    </view>
  </view>

  <view class="deadline-info">
    <text>早餐{{deadlines.breakfast}}截止 | 午餐{{deadlines.lunch}}截止 | 晚餐{{deadlines.dinner}}截止</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{!menuData}}" class="empty">
    <text>该日期菜单尚未发布</text>
  </view>

  <view wx:else class="menu-content">
    <view class="meal-section {{disabledMeals[item.type] ? 'disabled' : ''}}" wx:for="{{menuData.meals}}" wx:key="type">
      <view class="meal-header">
        <view class="meal-title">{{item.type}}</view>
        <view class="meal-deadline" wx:if="{{disabledMeals[item.type]}}">已截止</view>
        <view wx:elif="{{orders[item.type].status === 'ordered'}}" class="meal-ordered">已订</view>
      </view>
      <view class="dish-list">
        <view 
          class="dish-item {{isDishSelected(item.type, dish.name) ? 'selected' : ''}} {{disabledMeals[item.type] ? 'disabled' : ''}}" 
          wx:for="{{item.dishes}}" 
          wx:for-item="dish" 
          wx:key="name"
          data-meal-type="{{item.type}}"
          data-dish-name="{{dish.name}}"
          bindtap="toggleDish"
        >
          <view class="dish-info">
            <view class="dish-name">{{dish.name}}</view>
          </view>
          <view class="check-icon" wx:if="{{isDishSelected(item.type, dish.name)}}">✓</view>
        </view>
      </view>
      <view class="meal-footer">
        <view class="ordered-dishes" wx:if="{{userSelections[item.type].length > 0}}">
          <text>已选：{{userSelections[item.type].join('、')}}</text>
        </view>
        <button 
          wx:if="{{!disabledMeals[item.type]}}" 
          class="submit-btn {{userSelections[item.type].length === 0 ? 'disabled' : ''}}" 
          data-meal-type="{{item.type}}"
          bindtap="submitOrder"
        >
          {{orders[item.type].status === 'ordered' ? '修改' : '订餐'}}
        </button>
      </view>
    </view>
  </view>
</view>
