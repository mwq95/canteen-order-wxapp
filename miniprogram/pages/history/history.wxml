<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{orderList.length === 0}}" class="empty">
    <text>暂无订单记录</text>
  </view>

  <view wx:else class="order-list">
    <view class="order-card" wx:for="{{orderList}}" wx:key="_id">
      <view class="order-header">
        <view class="order-date">{{item.date}} {{item.mealType}}</view>
        <view class="order-status tag {{item.displayStatus === 'cancelled' ? 'tag-default' : (item.displayStatus === 'completed' ? 'tag-success' : 'tag-primary')}}">
          {{item.displayStatus === 'pending' ? '待用餐' : (item.displayStatus === 'cancelled' ? '已取消' : '已完成')}}
        </view>
      </view>
      
      <view class="order-dishes">
        <view class="dish-item" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="name">
          <text class="dish-name">{{dish.name}}</text>
        </view>
      </view>
      
      <view class="order-footer">
        <view class="order-actions">
          <button wx:if="{{item.canCancel}}" class="action-btn cancel-btn" data-id="{{item._id}}" bindtap="cancelOrder">取消预约</button>
          <text wx:elif="{{item.cancelReason}}" class="cancel-disabled-text">{{item.cancelReason}}</text>
          <button wx:if="{{item.showEvaluate && !item.evaluated}}" class="action-btn evaluate-btn" data-id="{{item._id}}" bindtap="goToEvaluate">评价</button>
          <text wx:if="{{item.evaluated}}" class="evaluated-text">已评价</text>
        </view>
      </view>
    </view>
  </view>
</view>