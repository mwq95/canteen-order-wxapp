<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{orderList.length === 0}}" class="empty">
    <text>暂无订单记录</text>
  </view>

  <view wx:else class="order-list">
    <view class="order-card" wx:for="{{orderList}}" wx:key="_id">
      <view class="order-header">
        <view class="order-date">{{item.date}}</view>
        <view class="order-status tag tag-primary">{{item.status === 'pending' ? '待用餐' : '已完成'}}</view>
      </view>
      
      <view class="order-dishes">
        <view class="dish-item" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="name">
          <text class="dish-tag tag">{{dish.mealType}}</text>
          <text class="dish-name">{{dish.name}}</text>
          <text wx:if="{{dish.price}}" class="dish-price">¥{{dish.price}}</text>
        </view>
      </view>
      
      <view class="order-footer">
        <view class="order-total">总计：<text class="price">¥{{item.totalPrice}}</text></view>
        <view class="order-actions">
          <button wx:if="{{item.status !== 'completed'}}" class="action-btn delete-btn" data-id="{{item._id}}" bindtap="deleteOrder">删除</button>
          <button wx:if="{{item.status === 'completed' && !item.evaluated}}" class="action-btn evaluate-btn" data-id="{{item._id}}" bindtap="goToEvaluate">评价</button>
          <text wx:if="{{item.evaluated}}" class="evaluated-text">已评价</text>
        </view>
      </view>
    </view>
  </view>
</view>