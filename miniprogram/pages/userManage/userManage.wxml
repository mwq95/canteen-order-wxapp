<view class="container">
  <view class="top-bar">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="输入关键词搜索..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text wx:if="{{searchKeyword}}" class="clear-icon" bindtap="clearSearch">✕</text>
    </view>
    <view class="add-btn" bindtap="onAddStaff">+</view>
  </view>

  <view wx:if="{{searchKeyword && filteredStaffList.length > 0}}" class="result-tip">
    共找到 {{filteredStaffList.length}} 条结果
  </view>

  <view class="staff-section-header" wx:if="{{filteredStaffList.length > 0}}">
    <view class="select-all" bindtap="toggleSelectAll">
      <text class="checkbox {{isAllSelected ? 'checked' : ''}}">✓</text>
      <text class="select-all-text">全选</text>
    </view>
    <text class="staff-count">共 {{filteredStaffList.length}} 人</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{filteredStaffList.length === 0}}" class="empty">
    <text wx:if="{{searchKeyword}}" class="empty-search">未找到"{{searchKeyword}}"的相关结果</text>
    <text wx:else class="empty-list">暂无人员</text>
    <view wx:if="{{searchKeyword}}" class="empty-action" bindtap="clearSearch">清除搜索</view>
    <view wx:else class="empty-action" bindtap="onAddStaff">添加人员</view>
  </view>

  <view wx:else class="staff-list">
    <view class="staff-card" wx:for="{{filteredStaffList}}" wx:key="_id">
      <view class="checkbox {{selectedIds[item._id] ? 'checked' : ''}}" bindtap="toggleSelect" data-id="{{item._id}}">
        <text wx:if="{{selectedIds[item._id]}}">✓</text>
      </view>

      <view class="staff-info" bindtap="toggleSelect" data-id="{{item._id}}">
        <view class="staff-header">
          <view class="staff-name">{{item.name}}</view>
          <view class="tag {{item.statusClass}}">{{item.displayStatus}}</view>
        </view>
        <view class="staff-detail">
          <text class="phone-text">{{item.phone}}</text>
          <text class="tag role-tag">{{item.displayRole}}</text>
        </view>
      </view>

      <view class="staff-actions">
        <text class="action-edit" bindtap="onEditStaff" data-staff="{{item}}">编辑</text>
        <text class="action-delete" bindtap="onDeleteStaff" data-staff="{{item}}">删除</text>
      </view>
    </view>
  </view>

  <view wx:if="{{selectedCount > 0}}" class="batch-bar">
    <text class="selected-tip">已选择 {{selectedCount}}/{{filteredStaffList.length}} 项</text>
    <view class="batch-actions">
      <text class="batch-btn cancel-btn" bindtap="cancelSelect">取消</text>
      <text class="batch-btn delete-btn" bindtap="batchDelete">删除</text>
    </view>
  </view>

  <view wx:if="{{showModal}}" class="modal-mask" bindtap="onCancelModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title">{{isEdit ? '编辑人员' : '添加人员'}}</view>
      </view>

      <view class="modal-body">
        <view class="form-item">
          <view class="form-label">手机号</view>
          <input
            class="form-input"
            type="number"
            placeholder="请输入手机号"
            value="{{formData.phone}}"
            bindinput="onPhoneInput"
            maxlength="11"
          />
        </view>

        <view class="form-item">
          <view class="form-label">姓名</view>
          <input
            class="form-input"
            placeholder="请输入姓名"
            value="{{formData.name}}"
            bindinput="onNameInput"
          />
        </view>

        <view class="form-item">
          <view class="form-label">角色</view>
          <picker
            mode="selector"
            range="{{roleOptions}}"
            range-key="label"
            value="{{roleIndex}}"
            bindchange="onRoleChange"
          >
            <view class="form-picker">
              {{roleOptions[roleIndex].label}}
            </view>
          </picker>
        </view>

        <view class="form-item">
          <view class="form-label">状态</view>
          <picker
            mode="selector"
            range="{{statusOptions}}"
            range-key="label"
            value="{{statusIndex}}"
            bindchange="onStatusChange"
          >
            <view class="form-picker">
              {{statusOptions[statusIndex].label}}
            </view>
          </picker>
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn modal-btn-cancel" bindtap="onCancelModal">取消</button>
        <button class="modal-btn modal-btn-confirm" bindtap="onConfirmModal">确定</button>
      </view>
    </view>
  </view>
</view>
