.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.total-bar {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.feedback-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.feedback-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.feedback-item:last-child {
  border-bottom: none;
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.feedback-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.feedback-time {
  font-size: 24rpx;
  color: #999;
}

.feedback-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}
