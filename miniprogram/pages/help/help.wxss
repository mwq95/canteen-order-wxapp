.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  text-align: center;
  margin-bottom: 36rpx;
  padding-top: 16rpx;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1890FF;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.help-item {
  margin-bottom: 24rpx;
}

.help-item:last-child {
  margin-bottom: 0;
}

.help-q {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.help-a {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-line;
  padding: 16rpx 16rpx 16rpx 24rpx;
  background: #fafafa;
  border-radius: 0 8rpx 8rpx 0;
  border-left: 4rpx solid #91d5ff;
}

.footer {
  text-align: center;
  padding: 40rpx 0;
}

.version {
  font-size: 24rpx;
  color: #ccc;
}
