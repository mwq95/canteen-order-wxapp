.container {
  padding: 20rpx;
  min-height: 100vh;
}

.date-picker {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.picker-text {
  font-size: 32rpx;
  color: #1890FF;
  font-weight: bold;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.summary-card {
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.summary-text {
  font-size: 28rpx;
  color: #fff;
}

.summary-count {
  font-size: 48rpx;
  font-weight: bold;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.order-id {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-dishes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.dish-name {
  font-size: 26rpx;
  color: #333;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.action-btn {
  background: #52c41a;
  color: #fff;
  border-radius: 48rpx;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  line-height: 1;
}

.action-btn::after {
  border: none;
}