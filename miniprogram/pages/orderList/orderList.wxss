.container {
  padding: 20rpx;
  min-height: 100vh;
}

.date-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.nav-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  border-radius: 50%;
  font-size: 36rpx;
  color: #666;
}

.date-display {
  font-size: 32rpx;
  color: #1890FF;
  font-weight: bold;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.detail-view {
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.back-btn {
  font-size: 28rpx;
  color: #1890FF;
  margin-right: 20rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stats-view {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.meal-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.meal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.meal-count {
  font-size: 28rpx;
  color: #1890FF;
}

.dish-stats {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.dish-stat {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.dish-stat-name {
  font-size: 28rpx;
  color: #333;
}

.dish-stat-count {
  font-size: 28rpx;
  color: #1890FF;
  font-weight: bold;
}

.empty-meal {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.view-detail {
  text-align: right;
  font-size: 24rpx;
  color: #1890FF;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.order-dishes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.dish-name {
  font-size: 26rpx;
  color: #333;
}
