<view class="container">
  <view class="date-picker">
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view class="picker-text">{{selectedDate}}</view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{orderList.length === 0}}" class="empty">
    <text>暂无订餐记录</text>
  </view>

  <view wx:else class="order-list">
    <view class="summary-card">
      <text class="summary-text">订餐人数：<text class="summary-count">{{orderList.length}}</text> 人</text>
    </view>
    
    <view class="order-card" wx:for="{{orderList}}" wx:key="_id">
      <view class="order-header">
        <view class="order-id">{{item.mealType}} #{{index + 1}}</view>
        <view class="order-status tag {{item.displayStatus === 'completed' ? 'tag-success' : 'tag-primary'}}">
          {{item.displayStatus === 'completed' ? '已完成' : '待用餐'}}
        </view>
      </view>
      
      <view class="order-dishes">
        <view class="dish-item" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="name">
          <text class="dish-name">{{dish.name}}</text>
        </view>
      </view>
    </view>
  </view>
</view>