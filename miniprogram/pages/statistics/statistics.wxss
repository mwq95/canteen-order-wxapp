.container {
  padding: 20rpx;
  min-height: 100vh;
}

.date-picker {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.picker-text {
  font-size: 32rpx;
  color: #1890FF;
  font-weight: bold;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stat-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890FF;
  text-align: center;
}

.dish-rank {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.dish-rank {
  width: 60rpx;
  height: 60rpx;
  background: #1890FF;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
}

.dish-count {
  font-size: 28rpx;
  color: #1890FF;
  font-weight: bold;
}