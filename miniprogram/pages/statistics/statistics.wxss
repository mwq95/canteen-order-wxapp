.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.arrow {
  font-size: 32rpx;
  color: #1890FF;
  padding: 10rpx 20rpx;
}

.date-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.loading, .empty, .empty-eval {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-card {
  text-align: center;
  padding: 40rpx 0;
}

.stat-number {
  font-size: 72rpx;
  font-weight: bold;
  color: #1890FF;
  display: block;
}

.stat-label {
  font-size: 28rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.dish-stats {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.dish-stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-stat-item:last-child {
  border-bottom: none;
}

.dish-name {
  font-size: 28rpx;
  color: #666;
}

.dish-count {
  font-size: 28rpx;
  color: #1890FF;
  font-weight: bold;
}

/* 菜品评价 */
.eval-section {
  margin-top: 10rpx;
}

.eval-count {
  font-size: 26rpx;
  color: #999;
  font-weight: normal;
}

.eval-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.eval-item:last-child {
  margin-bottom: 0;
}

.eval-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.eval-meal-tag {
  font-size: 22rpx;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.eval-meal-tag.breakfast {
  background: linear-gradient(135deg, #faad14, #ffc53d);
}

.eval-meal-tag.lunch {
  background: linear-gradient(135deg, #1890FF, #40a9ff);
}

.eval-meal-tag.dinner {
  background: linear-gradient(135deg, #722ed1, #b37feb);
}

.eval-dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.eval-rating-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stars-display {
  display: flex;
  gap: 4rpx;
}

.star-sm {
  font-size: 32rpx;
  color: #e8e8e8;
}

.star-sm.active {
  color: #faad14;
}

.avg-score {
  font-size: 36rpx;
  font-weight: bold;
  color: #faad14;
}

.rating-count {
  font-size: 24rpx;
  color: #999;
}

.comment-action {
  margin-top: 16rpx;
  text-align: right;
}

.view-comment-btn {
  font-size: 24rpx;
  color: #1890FF;
  padding: 8rpx 20rpx;
  background: #e6f7ff;
  border-radius: 20rpx;
  display: inline-block;
  line-height: 1.4;
  text-align: center;
}

/* 评论弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  max-height: 60vh;
  padding: 24rpx 30rpx;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-phone {
  font-size: 24rpx;
  color: #999;
}

.stars-xs {
  display: flex;
  gap: 2rpx;
}

.star-xs {
  font-size: 22rpx;
  color: #e8e8e8;
}

.star-xs.active {
  color: #faad14;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  word-break: break-all;
}

.no-comments {
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
  padding: 60rpx 0;
}
