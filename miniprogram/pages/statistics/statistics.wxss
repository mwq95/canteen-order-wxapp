.container {
  min-height: 100vh;
  padding: 20rpx 30rpx;
  background-color: #f5f7fa;
  box-sizing: border-box;
}

.loading, .empty, .empty-eval {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.eval-section {
  margin-top: 0;
}

.eval-count {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.eval-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e8e8e8;
}

.eval-item:last-child {
  margin-bottom: 0;
}

.eval-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.eval-meal-tag {
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.eval-meal-tag.breakfast {
  background: linear-gradient(135deg, #faad14, #ffc53d);
}

.eval-meal-tag.lunch {
  background: linear-gradient(135deg, #1890FF, #40a9ff);
}

.eval-meal-tag.dinner {
  background: linear-gradient(135deg, #722ed1, #b37feb);
}

.eval-dish-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
}

.eval-rating-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rating-left {
  display: flex;
  align-items: center;
}

.stars-display {
  display: inline-flex;
  gap: 2rpx;
  align-items: center;
}

.star-sm {
  font-size: 26rpx;
  color: #e0e0e0;
}

.star-sm.active {
  color: #faad14;
}

.avg-score {
  font-size: 28rpx;
  font-weight: bold;
  color: #faad14;
  margin-left: 10rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 16rpx;
}

.view-comment-btn {
  background: #e6f7ff;
  border-radius: 20rpx;
  padding: 10rpx 18rpx;
  flex-shrink: 0;
}

.view-comment-btn text {
  font-size: 22rpx;
  color: #1890FF;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  max-height: 60vh;
  padding: 16rpx 24rpx;
}

.comment-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.stars-xs {
  display: flex;
  gap: 2rpx;
}

.star-xs {
  font-size: 20rpx;
  color: #e8e8e8;
}

.star-xs.active {
  color: #faad14;
}

.comment-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.no-comments {
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
  padding: 60rpx 0;
}
