<view class="container">
  <date-nav date="{{selectedDate}}" bind:change="onDateChange" />

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <view class="section eval-section">
      <view class="section-title">
        菜品评价
        <text wx:if="{{evalStats && evalStats.totalEvaluations > 0}}" class="eval-count">
          共 {{evalStats.totalEvaluations}} 条
        </text>
      </view>

      <view wx:if="{{evalStats && evalStats.mealStats.length > 0}}">
        <view wx:for="{{evalStats.mealStats}}" wx:key="index" class="eval-item">
          <view class="eval-header">
            <view class="eval-meal-tag {{item.mealType === '早餐' ? 'breakfast' : item.mealType === '午餐' ? 'lunch' : 'dinner'}}">
              {{item.mealType}}
            </view>
            <view class="eval-dish-name">{{item.dishName}}</view>
          </view>
          <view class="eval-rating-row">
            <view class="rating-left">
              <view class="stars-display">
                <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this"
                  class="star-sm {{item.avgRating >= star ? 'active' : ''}}"
                >★</text>
              </view>
              <text class="avg-score">{{item.avgRating}}</text>
              <text class="rating-count">({{item.totalRatings}}人评)</text>
            </view>
            <view wx:if="{{item.comments.length > 0}}" class="view-comment-btn" bindtap="viewComments"
              data-comments="{{item.comments}}" data-dishname="{{item.dishName}}">
              <text>查看文字评价 ({{item.comments.length}})</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-eval">
        <text>暂无评价数据</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showCommentModal}}" class="modal-mask" bindtap="closeCommentModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{currentDishName}} - 评价详情</text>
        <text class="modal-close" bindtap="closeCommentModal">✕</text>
      </view>
      <scroll-view scroll-y class="modal-body">
        <view wx:for="{{currentComments}}" wx:key="index" class="comment-item">
          <view class="comment-top">
            <view class="stars-xs">
              <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="starIndex" wx:key="*this"
                class="star-xs {{item.rating >= starIndex ? 'active' : ''}}"
              >★</text>
            </view>
          </view>
          <text class="comment-text">{{item.comment}}</text>
        </view>
        <view wx:if="{{currentComments.length === 0}}" class="no-comments">
          暂无文字评价
        </view>
      </scroll-view>
    </view>
  </view>
</view>
